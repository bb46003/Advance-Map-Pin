<fieldset class="apo">
  <legend>{{localize "apo.header"}}</legend>
  <div class="form-group">
    <div class="enrich">
      <label>{{localize text.field.label}}</label>
      {{formInput
        text.field
        value=text.value
        enriched=text.enriched
        toggled="true"
      }}
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "apo.useImg"}}</label>
    <div class="form-fields flexrow">
      <input type="text" name="flags.advance-map-pin.img" value="{{img}}" />
      <button type="button" class="file-picker" data-type="image" data-target="flags.advance-map-pin.img">
        <i class="fas fa-folder-open"></i>
      </button>
    </div>
  </div>
  <div class="form-group" >
    <label>{{localize "apo.hideLabel"}}</label>  
    <input type="checkbox" name="hideLabel" {{#if hideLabel}}checked{{/if}}>
  </div>
  <div class="form-group" >
    <label>{{localize "apo.alwaysVisible"}}</label>  
    <input type="checkbox" name="alwaysShow" {{#if alwaysShow}}checked{{/if}}>
  </div>
    <div class="form-group" >
    <label>{{localize "apo.hasBackground"}}</label>  
    <input type="checkbox" name="hasBackground" {{#if hasBackground}}checked{{/if}}>
  </div>
  {{#if doNotHaveJournal}}
  <div class="form-group" >
    <label>{{localize "apo.showtouser"}}</label>
    <div class="flexcol">
    {{#each users as |user index|}}
      <div class="flexrow users">
        <label class="user">{{user.name}}</label>
        <input class="apo-user-checkbox" type="checkbox" data-id="{{user.id}}" {{#if (lookup @root.allowUsers user.id)}}checked{{/if}}></input>
      </div>
    {{/each}}
    </div>
  </div>
  {{/if}}
</fieldset>